<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        El backend de desarrollo sirve HTTP plano. Android lo bloquea por
        defecto desde API 28, así que sin esto el login falla en release.
        Se limita a los hosts locales: cualquier dominio real sigue exigiendo HTTPS.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- 10.0.2.2 es el alias del host de la máquina desde el emulador. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- MinIO en la red local: de ahí llegan las URLs firmadas de las
             imágenes, con el mismo esquema HTTP plano que el backend. -->
        <domain includeSubdomains="false">192.168.1.8</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
